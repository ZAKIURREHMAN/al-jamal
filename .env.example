# Database
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/al_jamal?schema=public"

# Auth (change in production — generate with: openssl rand -base64 48)
AUTH_SECRET="replace-with-a-long-random-secret"

# Seeded admin account (used only by `npm run db:seed`)
ADMIN_EMAIL="admin@aljamal.pk"
ADMIN_PASSWORD="choose-a-strong-password"

# Public site URL (used for metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Store settings
DELIVERY_CHARGE_PKR="250"
FREE_DELIVERY_THRESHOLD_PKR="5000"
