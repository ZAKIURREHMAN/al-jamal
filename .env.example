# ---------- Database (Docker) ----------
POSTGRES_USER=aljamal
POSTGRES_PASSWORD=CHANGE_ME_hex_password
POSTGRES_DB=al_jamal
POSTGRES_PORT=5433
# Used by `npm run dev`, Prisma CLI and scripts on this machine (the app container builds its own URL)
DATABASE_URL="postgresql://aljamal:CHANGE_ME_hex_password@localhost:5433/al_jamal?schema=public"

# ---------- Auth ----------
# Random session-signing secret. Rotate with: openssl rand -base64 48 (signs everyone out)
AUTH_SECRET="CHANGE_ME_run_openssl_rand_base64_48"
# First admin account. Only used to create the account on an empty database; change the password in Admin → Account.
ADMIN_EMAIL="admin@aljamal.pk"
ADMIN_PASSWORD="CHANGE_ME_at_least_10_chars"

# ---------- Site ----------
NEXT_PUBLIC_SITE_URL="https://al-jamal.shop"
# Host port for the app container 
APP_PORT=3000

# Defaults for delivery; editable later in Admin → Settings
DELIVERY_CHARGE_PKR="250"
FREE_DELIVERY_THRESHOLD_PKR="5000"

# ---------- SEO / analytics (optional) ----------
NEXT_PUBLIC_GA_ID=""
GOOGLE_SITE_VERIFICATION=""

# ---------- Email notifications (optional) ----------
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=<your gmail>, SMTP_PASS=<16-character App Password>
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
