generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(ADMIN)
  isActive     Boolean  @default(true)
  /// Incremented to invalidate every existing session for this user ("sign out everywhere").
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reviewsReviewed Review[] @relation("ReviewedBy")
  manualSales     ManualSale[] @relation("ManualSalesBy")
  auditLogs       AuditLog[]
}

model Product {
  id               String           @id @default(cuid())
  slug             String           @unique
  name             String
  shortDescription String
  description      String
  isActive         Boolean          @default(true)
  isFeatured       Boolean          @default(false)
  sortOrder        Int              @default(0)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  variants    ProductVariant[]
  images      ProductImage[]
  reviews     Review[]
  manualSales ManualSale[]

  @@index([isActive, isFeatured, sortOrder])
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label       String // e.g. "500g", "1kg"
  weightGrams Int
  priceCents  Int // PKR stored in paisa (integer) to avoid float errors
  stock       Int      @default(0)
  sku         String?  @unique
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems  OrderItem[]
  manualSales ManualSale[]

  @@unique([productId, label])
  @@index([productId, isActive])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId, sortOrder])
}

model Customer {
  id        String   @id @default(cuid())
  phone     String   @unique
  fullName  String
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

model Order {
  id            String        @id @default(cuid())
  orderNumber   String        @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(COD)

  // Delivery snapshot (kept on the order so later customer edits don't change history)
  fullName     String
  phone        String
  addressLine  String
  city         String
  notes        String?

  subtotalCents  Int
  deliveryCents  Int
  totalCents     Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items         OrderItem[]
  statusHistory OrderStatusHistory[]

  @@index([status, createdAt])
  @@index([customerId])
  @@index([createdAt])
}

model OrderItem {
  id         String          @id @default(cuid())
  orderId    String
  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId  String?
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // Snapshot of what was bought, at the price it was bought for
  productName   String
  variantLabel  String
  unitPriceCents Int
  quantity      Int
  lineTotalCents Int

  @@index([orderId])
  @@index([variantId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())

  @@index([orderId, createdAt])
}

model Review {
  id           String    @id @default(cuid())
  productId    String?
  product      Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  customerName String
  city         String?
  rating       Int
  body         String
  isApproved   Boolean   @default(false)
  reviewedById String?
  reviewedBy   User?     @relation("ReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([isApproved, createdAt])
  @@index([productId])
}

/// A sale recorded by hand (WhatsApp, phone, walk-in) with a custom price, so dashboard totals reflect all revenue.
model ManualSale {
  id           String   @id @default(cuid())
  amountCents  Int
  description  String
  customerName String?
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId    String?
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  quantity     Int      @default(1)
  /// True when this sale reduced the variant's stock (restored if the sale is deleted).
  stockDeducted Boolean @default(false)
  soldAt       DateTime @default(now())
  createdById  String?
  createdBy    User?    @relation("ManualSalesBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([soldAt])
}

/// Editable store settings (contact details, delivery charges, thresholds). One row per key.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Who changed what in the admin.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail String
  action    String
  entity    String
  entityId  String?
  summary   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

/// Messages sent through the contact form.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

/// Database-backed rate limiting so limits survive restarts and work across instances.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
